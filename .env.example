APP_ENV=development
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=auto
APP_LOG_ACCESS_ENABLED=true

POSTGRES_USER=softplan
POSTGRES_PASSWORD=softplan
POSTGRES_DB=softplan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://softplan:softplan@localhost:5432/softplan

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=softplan

FILE_CONVERT_SERVICE_BASE_URL=http://file-convert-service:8000
LLM_SERVICE_BASE_URL=http://llm-service:8000
LLM_SERVICE_TIMEOUT_SECONDS=30

LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
EXTRACTED_IMAGE_SEMANTIC_MODEL=Qwen/Qwen3.5-35B-A3B
EXTRACTED_IMAGE_SEMANTIC_PROMPT_PATH=backend/app/prompts/extracted_image_semantic.txt
EXTRACTED_IMAGE_SEMANTIC_TASK_WORKER_ENABLED=true
EXTRACTED_IMAGE_SEMANTIC_TASK_WORKER_POLL_INTERVAL_SECONDS=1.0

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

DOCUMENT_PARSING_TASK_WORKER_ENABLED=true
DOCUMENT_PARSING_TASK_WORKER_POLL_INTERVAL_SECONDS=1.0
